[include]
	path = ~/.gitconfig.local
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[fetch]
	prune = true
# Large File Storage settings added by GitHub desktop
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[url "git@github.com:"]
	insteadOf = https://github.com/
